    {
      "id": "config-text",
      "type": "text",
      "x": 610,
      "y": 60,
      "width": 300,
      "height": 470,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 461,
      "version": 2,
      "versionNonce": 1297749419,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773163922118,
      "link": null,
      "locked": false,
      "text": "⚙️ config.py (Pydantic BaseSettings)\n\nRequired env vars:\n  DATABASE_URL  PostgreSQL conn string\n  SECRET_KEY    JWT signing key\n  ENCRYPTION_KEY  Fernet symmetric key\n\nOptional env vars:\n  REDIS_URL     fallback: InMemoryCache\n  ALLOWED_ORIGINS  CORS whitelist\n  AUDIT_LOG_RETENTION_DAYS  default 30\n  ACCESS_TOKEN_EXPIRE_MINUTES\n    default 10080 (7 days)\n  LOG_LEVEL     default INFO\n\nFrontend env vars:\n  VITE_API_URL  backend base URL\n  VITE_AUTO_LOGOUT_MINUTES  default 15\n\n🗄️ Alembic Migrations\n  backend/alembic/versions/\n  alembic upgrade head\n  alembic revision --autogenerate\n    -m \"description\"\n\n🌱 Seed Scripts\n  seed_admin.py  create initial admin\n  seed_db.py     sample data",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 465,
      "containerId": null,
      "originalText": "⚙️ config.py (Pydantic BaseSettings)\n\nRequired env vars:\n  DATABASE_URL  PostgreSQL conn string\n  SECRET_KEY    JWT signing key\n  ENCRYPTION_KEY  Fernet symmetric key\n\nOptional env vars:\n  REDIS_URL     fallback: InMemoryCache\n  ALLOWED_ORIGINS  CORS whitelist\n  AUDIT_LOG_RETENTION_DAYS  default 30\n  ACCESS_TOKEN_EXPIRE_MINUTES\n    default 10080 (7 days)\n  LOG_LEVEL     default INFO\n\nFrontend env vars:\n  VITE_API_URL  backend base URL\n  VITE_AUTO_LOGOUT_MINUTES  default 15\n\n🗄️ Alembic Migrations\n  backend/alembic/versions/\n  alembic revision --autogenerate\n    -m \"description\"\n\n🌱 Seed Scripts\n  seed_admin.py  create initial admin\n  seed_db.py     sample data",
      "index": "af",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.291208791208791
    },
