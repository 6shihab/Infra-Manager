      "isDeleted": false,
      "boundElements": [],
      "updated": 1773164613768,
      "link": null,
      "locked": false,
      "text": "👤 User\n  id, email, hashed_password, full_name\n  is_active, is_superuser\n\n👥 Group\n  id, name, description\n\n🔗 user_group_link  (M:M join)\n  user_id ↔ group_id\n\n🔑 ProjectGroupAccess\n  project_id, group_id\n  access_level: Viewer|Editor|Admin\n\n🔑 ProjectUserAccess\n  project_id, user_id\n  access_level: Viewer|Editor|Admin\n\n🚫 TokenBlocklist\n  token (unique), created_at\n  (JWT revocation on logout)\n\n⚙️ Setting\n  key (PK), value, description\n\n📋 AuditLog\n  user_id, action (CREATED|UPDATED|\n  DELETED|GRANTED_ACCESS|REVEALED…)\n  resource_type, resource_name\n  timestamp  (retention: 30 days)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 365,
      "containerId": null,
      "originalText": "👤 User\n  id, email, hashed_password, full_name\n  is_active, is_superuser\n\n👥 Group\n  id, name, description\n\n🔗 user_group_link  (M:M join)\n  user_id ↔ group_id\n\n🔑 ProjectGroupAccess\n  project_id, group_id\n  access_level: Viewer|Editor|Admin\n\n🔑 ProjectUserAccess\n  project_id, user_id\n  access_level: Viewer|Editor|Admin\n\n🚫 TokenBlocklist\n  token (unique), created_at\n  (JWT revocation on logout)\n\n⚙️ Setting\n  key (PK), value, description\n\n📋 AuditLog\n  user_id, action (CREATED|UPDATED|\n  DELETED|GRANTED_ACCESS|REVEALED…)\n  resource_type, resource_name\n  timestamp  (retention: 30 days)",
      "index": "aj",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 0.9487179487179488
