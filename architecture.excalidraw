      "isDeleted": false,
      "boundElements": [],
      "updated": 1773163922118,
      "link": null,
      "locked": false,
      "text": "📁 Project\n  name, description, primary_domain\n  environment: Dev|Staging|Prod\n  is_online, last_checked_at\n  is_deleted🗑️, deleted_at, created_by\n\n🖥️ Server\n  name, ip_address, os, region\n  username, password🔒, ssh_key🔒\n  is_online, last_checked_at\n  is_deleted🗑️, deleted_at, created_by\n\n🔗 ProjectServer  (M:M + overrides)\n  project_id, server_id\n  username?, password🔒?, ssh_key🔒?\n\n🗄️ DatabaseEngine\n  name, engine (postgres|mysql|…)\n  host, port, username, password🔒\n  is_deleted🗑️, deleted_at, created_by\n\n🔗 ProjectDatabase  (M:M + overrides)\n  project_id, database_engine_id\n  db_name?, username?, password🔒?\n\n🧩 Component\n  name, type (S3|Redis|DNS|…)\n  project_id  (project-scoped)\n  custom_fields: EncryptedJSON🔒\n  is_deleted🗑️, deleted_at",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 365,
      "containerId": null,
      "originalText": "📁 Project\n  name, description, primary_domain\n  environment: Dev|Staging|Prod\n  is_online, last_checked_at\n  is_deleted🗑️, deleted_at, created_by\n\n🖥️ Server\n  name, ip_address, os, region\n  username, password🔒, ssh_key🔒\n  is_online, last_checked_at\n  is_deleted🗑️, deleted_at, created_by\n\n🔗 ProjectServer  (M:M + overrides)\n  project_id, server_id\n  username?, password🔒?, ssh_key🔒?\n\n🗄️ DatabaseEngine\n  name, engine (postgres|mysql|…)\n  host, port, username, password🔒\n  is_deleted🗑️, deleted_at, created_by\n\n🔗 ProjectDatabase  (M:M + overrides)\n  project_id, database_engine_id\n  db_name?, username?, password🔒?\n\n🧩 Component\n  name, type (S3|Redis|DNS|…)\n  project_id  (project-scoped)\n  custom_fields: EncryptedJSON🔒\n  is_deleted🗑️, deleted_at",
